@echo off
rem JBangLite launcher for Windows. It is self-contained: everything the
rem PowerShell launcher used to be asked to do - downloading a JDK, downloading
rem jbang.jar, replacing a staged jbang.jar.new - is done here with the tools
rem Windows ships with (curl, tar, certutil), so CMD is the only shell needed.
rem
rem When JBang asks for a command to be executed (exit code 255) that command is
rem run in this shell.
setlocal

rem JBang itself only needs a JVM to run; which one hardly matters, so when the
rem machine has none we simply fetch the newest Temurin of this feature version.
set "bootstrapJavaVersion=25"
rem The oldest Java that can run jbang.jar; anything newer is fine, and the JDK
rem a script asks for with //JAVA is chosen by jbang.jar itself
set "minJavaVersion=11"

rem Where the JVM index lives. It is the same index jbang.jar uses to install
rem the JDKs that scripts ask for with //JAVA, published on Maven Central, so no
rem JDK discovery service is involved. Override for a corporate mirror.
if "%JBANG_JVM_INDEX_BASEURL%"=="" (set "jvmIndexBaseUrl=https://repo1.maven.org/maven2") else (set "jvmIndexBaseUrl=%JBANG_JVM_INDEX_BASEURL%")

rem Base URL the wrapper (jbangw) downloads jbang.jar from. The wrapper is
rem installed into a project with install.sh/install.cmd, which records the
rem repository and revision to take the jar from in jbanglite.properties next to
rem this script. Override for testing or a corporate mirror.
if "%JBANGLITE_RAW_BASEURL%"=="" (set "jbangRawBaseUrl=https://raw.githubusercontent.com") else (set "jbangRawBaseUrl=%JBANGLITE_RAW_BASEURL%")

rem Base URL for downloading JBang releases.
if "%JBANG_DOWNLOAD_BASEURL%"=="" (set "jbangDownloadBaseUrl=https://github.com/instreest/jbang/releases") else (set "jbangDownloadBaseUrl=%JBANG_DOWNLOAD_BASEURL%")

rem Number of retry attempts for downloads
if "%JBANG_DOWNLOAD_RETRY%"=="" (set "downloadRetry=5") else (set "downloadRetry=%JBANG_DOWNLOAD_RETRY%")
if "%JBANG_DOWNLOAD_RETRY_DELAY%"=="" (set "downloadRetryDelay=0") else (set "downloadRetryDelay=%JBANG_DOWNLOAD_RETRY_DELAY%")

if "%JBANG_DIR%"=="" (set "JBDIR=%userprofile%\.jbang") else (set "JBDIR=%JBANG_DIR%")
if "%JBANG_CACHE_DIR%"=="" (set "TDIR=%JBDIR%\cache") else (set "TDIR=%JBANG_CACHE_DIR%")

rem %~dp0 in a subroutine is the label, not this file, so remember where we are
set "SCRIPTDIR=%~dp0"

rem Setup environment for execution
set "JBANG_RUNTIME_SHELL=cmd"
set "JBANG_LAUNCH_CMD=%~f0"
rem tell jbang whether stdin is a tty or not
2>nul >nul timeout /t 0 && (set "JBANG_STDIN_NOTTY=false") || (set "JBANG_STDIN_NOTTY=true")

rem detect architecture for platform-specific lookups
set "jbang_arch=x64"
set "jbang_index_arch=amd64"
if /i "%PROCESSOR_ARCHITECTURE%"=="ARM64" (
  set "jbang_arch=aarch64"
  set "jbang_index_arch=arm64"
)

rem Run the native binary next to this script
if not "%JBANG_USE_NATIVE%"=="true" goto :jar
if exist "%SCRIPTDIR%jbang.bin-windows-%jbang_arch%.exe" (
  set CMD="%SCRIPTDIR%jbang.bin-windows-%jbang_arch%.exe"
  goto :run
)
if exist "%SCRIPTDIR%jbang.bin.exe" (
  set CMD="%SCRIPTDIR%jbang.bin.exe"
  goto :run
)
echo WARNING: JBang native binary (jbang.bin-windows-%jbang_arch%.exe or jbang.bin.exe^) not found in %SCRIPTDIR% 1>&2

:jar
rem Find the jar to run: next to this script, in .jbang next to it, or - for a
rem wrapper installed in a project - the one jbanglite.properties points at
set "jarPath="
if exist "%SCRIPTDIR%jbang.jar" (
  set "jarPath=%SCRIPTDIR%jbang.jar"
) else if exist "%SCRIPTDIR%.jbang\jbang.jar" (
  set "jarPath=%SCRIPTDIR%.jbang\jbang.jar"
) else if exist "%SCRIPTDIR%jbanglite.properties" (
  call :install_wrapper_jar || exit /b 1
  set "jarPath=%SCRIPTDIR%.jbang\jbang.jar"
)
if defined jarPath goto :jar_found
rem Nothing to run next to this script: use (and if needed install) the JBang in
rem %JBDIR%\bin (a parenthesized block would expand %ERRORLEVEL% too early)
if not exist "%JBDIR%\bin\jbang.jar" goto :jar_install
if not exist "%JBDIR%\bin\jbang.cmd" goto :jar_install
goto :jar_installed
:jar_install
call :install_jbang || exit /b 1
:jar_installed
call "%JBDIR%\bin\jbang.cmd" %*
exit /b %ERRORLEVEL%

:jar_found
rem a new jbang version was found, we replace the old one with it
if exist "%jarPath%.new" move /y "%jarPath%.new" "%jarPath%" >nul

call :find_java || exit /b 1
set CMD="%JAVA_EXEC%" %JBANG_JAVA_OPTIONS% -jar "%jarPath%"

:run
rem execute jbang and redirect output to temporary file
rem (WARNING running jbang in parallel in quick succession will cause temp name collisions!!)
set "tmpfile=%TEMP%\%RANDOM%.jbang.tmp"
%CMD% %* > "%tmpfile%"
set "ERROR=%ERRORLEVEL%"
if %ERROR% EQU 255 goto :execute

type "%tmpfile%"
del /f /q "%tmpfile%"
exit /b %ERROR%

:execute
rem read the command generated by jbang (first line only), delete the temporary file and execute it
set "OUTPUT="
for /f "usebackq delims=" %%L in ("%tmpfile%") do if not defined OUTPUT set "OUTPUT=%%L"
del /f /q "%tmpfile%"
%OUTPUT%
exit /b %ERRORLEVEL%

rem ---------------------------------------------------------------------------
rem Downloading
rem ---------------------------------------------------------------------------

rem Downloads %dlUrl% to %dlOut%, retrying with a backoff. Fails when the
rem download does. The URL is passed in a variable rather than as an argument
rem because CALL expands % a second time and the JDK URLs contain %%2B.
:download
setlocal
set "url=%dlUrl%"
set "out=%dlOut%"
set /a attempt=0
:download_try
set /a attempt+=1
curl -fsSL "%url%" -o "%out%" 2>nul && (endlocal & exit /b 0)
if %attempt% GTR %downloadRetry% (endlocal & exit /b 1)
if %downloadRetryDelay% GTR 0 (
  set /a sleep=%downloadRetryDelay%
) else (
  rem Exponential backoff: 1, 2, 4, 8, ...
  set /a sleep=1
  for /l %%I in (2,1,%attempt%) do set /a sleep*=2
)
set /a total=%downloadRetry%+1
call echo Download %attempt%/%total% failed. Retry in %%sleep%% second(s)... 1>&2
if %attempt% EQU 1 echo (Set JBANG_DOWNLOAD_RETRY=0 to disable retries^) 1>&2
call :sleep %%sleep%%
goto :download_try

rem Waits %1 seconds without needing a console (timeout /t fails when redirected)
:sleep
set /a pings=%~1+1
ping -n %pings% 127.0.0.1 >nul 2>&1
exit /b 0

rem Sets sha256Result to the lower-case SHA-256 of the file %1
:sha256
setlocal enabledelayedexpansion
set "h="
for /f "usebackq skip=1 delims=" %%H in (`certutil -hashfile "%~1" SHA256 2^>nul`) do if not defined h set "h=%%H"
set "h=!h: =!"
endlocal & set "sha256Result=%h%"
exit /b 0

rem ---------------------------------------------------------------------------
rem The jar
rem ---------------------------------------------------------------------------

rem Downloads jbang.jar into <wrapper dir>\.jbang as told by jbanglite.properties
:install_wrapper_jar
set "wrepo=" & set "wref=" & set "wsha="
for /f "usebackq tokens=1,* delims==" %%K in ("%SCRIPTDIR%jbanglite.properties") do (
  if "%%K"=="repo" set "wrepo=%%L"
  if "%%K"=="ref" set "wref=%%L"
  if "%%K"=="jarSha256" set "wsha=%%L"
)
if "%wrepo%"=="" goto :install_wrapper_jar_unusable
if "%wref%"=="" goto :install_wrapper_jar_unusable
set "wjarUrl=%jbangRawBaseUrl%/%wrepo%/%wref%/dist/jbang.jar"
set "wjar=%SCRIPTDIR%.jbang\jbang.jar"
if not exist "%SCRIPTDIR%.jbang" mkdir "%SCRIPTDIR%.jbang"
echo Downloading JBangLite from %wjarUrl%... 1>&2
set "dlUrl=%wjarUrl%"
set "dlOut=%wjar%.tmp"
call :download
if errorlevel 1 (
  del /f /q "%wjar%.tmp" 2>nul
  echo Error downloading JBangLite from %wjarUrl% 1>&2
  exit /b 1
)
if "%wsha%"=="" goto :install_wrapper_jar_keep
call :sha256 "%wjar%.tmp"
if /i "%wsha%"=="%sha256Result%" goto :install_wrapper_jar_keep
del /f /q "%wjar%.tmp" 2>nul
echo SHA-256 mismatch for %wjarUrl%: expected %wsha% but got %sha256Result% 1>&2
exit /b 1

:install_wrapper_jar_keep
move /y "%wjar%.tmp" "%wjar%" >nul
exit /b 0

:install_wrapper_jar_unusable
echo %SCRIPTDIR%jbanglite.properties does not name a repo and a ref to get jbang.jar from 1>&2
exit /b 1

rem Downloads and installs a JBang release into %JBDIR%\bin
:install_jbang
setlocal
if "%JBANG_USE_NATIVE%"=="true" (set "bundleName=jbang-windows-%jbang_arch%.zip") else (set "bundleName=jbang.zip")
if not "%JBANG_DOWNLOAD_URL%"=="" (
  set "jburl=%JBANG_DOWNLOAD_URL%"
) else if "%JBANG_DOWNLOAD_VERSION%"=="" (
  set "jburl=%jbangDownloadBaseUrl%/latest/download/%bundleName%"
) else (
  rem Numeric versions get a 'v' prefix (e.g. 0.120.0 -> v0.120.0); named
  rem release tags (e.g. 'early-access', '1.0.0-rc1') are used as-is.
  call :release_tag "%JBANG_DOWNLOAD_VERSION%"
  call set "jburl=%jbangDownloadBaseUrl%/download/%%releaseTag%%/%bundleName%"
)
if "%JBANG_DOWNLOAD_VERSION%"=="" (set "dlVersion=latest") else (set "dlVersion=%JBANG_DOWNLOAD_VERSION%")
if not exist "%TDIR%\urls" mkdir "%TDIR%\urls"
echo Downloading JBang %dlVersion% from %jburl%... 1>&2
set "dlUrl=%jburl%"
set "dlOut=%TDIR%\urls\jbang.zip"
call :download || (
  echo Error downloading JBang from %jburl% to %TDIR%\urls\jbang.zip 1>&2
  endlocal & exit /b 1
)
echo Installing JBang... 1>&2
if exist "%TDIR%\urls\jbang" rmdir /s /q "%TDIR%\urls\jbang"
tar -xf "%TDIR%\urls\jbang.zip" -C "%TDIR%\urls" || (
  echo Error unzipping JBang from %TDIR%\urls\jbang.zip to %TDIR%\urls 1>&2
  endlocal & exit /b 1
)
if not exist "%JBDIR%\bin" mkdir "%JBDIR%\bin"
del /f /q "%JBDIR%\bin\jbang" "%JBDIR%\bin\jbang.*" 2>nul
copy /y "%TDIR%\urls\jbang\bin\*" "%JBDIR%\bin" >nul
endlocal & exit /b 0

rem Sets releaseTag for the version %1: numeric versions get a 'v' prefix
:release_tag
setlocal
set "v=%~1"
set "digits=%v:0=%"
set "digits=%digits:1=%" & set "digits=%digits:2=%" & set "digits=%digits:3=%"
set "digits=%digits:4=%" & set "digits=%digits:5=%" & set "digits=%digits:6=%"
set "digits=%digits:7=%" & set "digits=%digits:8=%" & set "digits=%digits:9=%"
set "digits=%digits:.=%"
if "%digits%"=="" (set "tag=v%v%") else (set "tag=%v%")
endlocal & set "releaseTag=%tag%"
exit /b 0

rem ---------------------------------------------------------------------------
rem The JDK to run the jar with
rem ---------------------------------------------------------------------------

rem Determines the java to run the jar with, fetching one when the machine has
rem none. Sets JAVA_EXEC and JAVA_HOME.
:find_java
rem The JDK JBang picked as the default
call :usable_java "%JBDIR%\currentjdk" && (
  set "JAVA_HOME=%JBDIR%\currentjdk"
  set "JAVA_EXEC=%JBDIR%\currentjdk\bin\java.exe"
  exit /b 0
)
rem Then the JDK this script downloaded on an earlier run
call :usable_java "%TDIR%\jdks\bootstrap" && (
  set "JAVA_HOME=%TDIR%\jdks\bootstrap"
  set "JAVA_EXEC=%TDIR%\jdks\bootstrap\bin\java.exe"
  exit /b 0
)
rem Then JAVA_HOME, but only when it points to a Java that is recent enough
if "%JAVA_HOME%"=="" goto :find_java_install
if not exist "%JAVA_HOME%\bin\java.exe" (
  echo JAVA_HOME is set but does not seem to point to a Java runtime 1>&2
  goto :find_java_install
)
call :java_major "%JAVA_HOME%"
if "%javaMajor%"=="" (
  echo JAVA_HOME is set but the Java version could not be determined, ignoring it 1>&2
  goto :find_java_install
)
if %javaMajor% LSS %minJavaVersion% (
  echo JAVA_HOME points to Java %javaMajor% which is older than Java %minJavaVersion%, ignoring it 1>&2
  goto :find_java_install
)
set "JAVA_EXEC=%JAVA_HOME%\bin\java.exe"
exit /b 0

:find_java_install
rem Nothing usable found, so fetch a JVM of our own
call :install_bootstrap_jdk || exit /b 1
set "JAVA_HOME=%TDIR%\jdks\bootstrap"
set "JAVA_EXEC=%TDIR%\jdks\bootstrap\bin\java.exe"
exit /b 0

rem Succeeds when %1 holds a Java new enough to run jbang.jar
:usable_java
if not exist "%~1\bin\java.exe" exit /b 1
call :java_major "%~1"
if "%javaMajor%"=="" exit /b 1
if %javaMajor% LSS %minJavaVersion% exit /b 1
exit /b 0

rem Sets javaMajor to the major version of the JDK in %1 as read from its
rem 'release' file (e.g. 8, 11, 17); leaves it empty when it cannot be determined.
rem Only the JAVA_VERSION line is used, so a broken or fake 'release' file just
rem causes the JDK to be ignored.
:java_major
set "javaMajor="
if not exist "%~1\release" exit /b 0
for /f "usebackq tokens=1* delims==" %%A in ("%~1\release") do if "%%A"=="JAVA_VERSION" set "javaMajor=%%~B"
if "%javaMajor%"=="" exit /b 0
for /f "tokens=1,2 delims=." %%A in ("%javaMajor%") do (
  if "%%A"=="1" (set "javaMajor=%%B") else (set "javaMajor=%%A")
)
exit /b 0

rem Downloads the newest Temurin %bootstrapJavaVersion% into %TDIR%\jdks\bootstrap
:install_bootstrap_jdk
if not exist "%TDIR%\jdks" mkdir "%TDIR%\jdks"
call :jvm_index_entry "windows-%jbang_index_arch%" || exit /b 1
if "%idxUrl%"=="" (
  echo No Temurin %bootstrapJavaVersion% found in the JVM index for windows-%jbang_index_arch% 1>&2
  exit /b 1
)
rem The index says how the archive is packed; keep its extension so the file on
rem disk matches what was downloaded, as jbang.jar does
if "%idxType%"=="tgz" (set "ext=tar.gz") else (set "ext=%idxType%")
set "archive=%TDIR%\bootstrap-jdk.%ext%"

echo No Java found. Downloading Temurin %idxVersion%. Be patient, this can take several minutes... 1>&2
set "dlUrl=%idxUrl%"
set "dlOut=%archive%"
call :download
if errorlevel 1 (
  echo Error downloading JDK from %idxUrl% 1>&2
  exit /b 1
)
call :verify_archive || exit /b 1

echo Installing Temurin %idxVersion%... 1>&2
if exist "%TDIR%\jdks\bootstrap.tmp" rmdir /s /q "%TDIR%\jdks\bootstrap.tmp"
mkdir "%TDIR%\jdks\bootstrap.tmp"
tar -xf "%archive%" -C "%TDIR%\jdks\bootstrap.tmp"
if errorlevel 1 goto :install_bootstrap_jdk_broken
rem the archive holds a single root folder, which becomes the JDK directory
set "jdkRoot=%TDIR%\jdks\bootstrap.tmp"
for /d %%D in ("%TDIR%\jdks\bootstrap.tmp\*") do if exist "%%D\bin\java.exe" set "jdkRoot=%%D"
if not exist "%jdkRoot%\bin\java.exe" goto :install_bootstrap_jdk_broken
if exist "%TDIR%\jdks\bootstrap" rmdir /s /q "%TDIR%\jdks\bootstrap"
move "%jdkRoot%" "%TDIR%\jdks\bootstrap" >nul
if exist "%TDIR%\jdks\bootstrap.tmp" rmdir /s /q "%TDIR%\jdks\bootstrap.tmp"
del /f /q "%archive%" "%TDIR%\bootstrap-jdk.sha256" 2>nul
exit /b 0

:install_bootstrap_jdk_broken
if exist "%TDIR%\jdks\bootstrap.tmp" rmdir /s /q "%TDIR%\jdks\bootstrap.tmp"
echo Error installing JDK 1>&2
exit /b 1

rem Checks %archive% against the SHA-256 Temurin publishes next to it. A missing
rem checksum only warns; a wrong one deletes the archive and fails.
:verify_archive
set "dlUrl=%idxUrl%.sha256.txt"
set "dlOut=%TDIR%\bootstrap-jdk.sha256"
call :download
if errorlevel 1 (
  echo No published SHA-256 found for %idxUrl%, skipping verification 1>&2
  exit /b 0
)
set "expected="
for /f "usebackq tokens=1" %%S in ("%TDIR%\bootstrap-jdk.sha256") do if not defined expected set "expected=%%S"
call :sha256 "%archive%"
if /i "%expected%"=="%sha256Result%" exit /b 0
del /f /q "%archive%" 2>nul
echo SHA-256 mismatch for %idxUrl%: expected %expected% but got %sha256Result% 1>&2
exit /b 1

rem Sets idxVersion, idxType and idxUrl to the newest Temurin
rem %bootstrapJavaVersion% in the JVM index for the platform %1, the same index
rem jbang.jar uses for the JDKs that //JAVA asks for
:jvm_index_entry
setlocal enabledelayedexpansion
set "plat=%~1"
if not exist "%TDIR%" mkdir "%TDIR%"
set "base=%jvmIndexBaseUrl%/io/get-coursier/jvm/indices/index-%plat%"
set "dlUrl=!base!/maven-metadata.xml"
set "dlOut=%TDIR%\jvm-index.xml"
call :download || (
  echo Could not read the JVM index from !base! 1>&2
  endlocal & exit /b 1
)
set "metaVersion="
for /f "usebackq delims=" %%L in (`findstr "<release>" "%TDIR%\jvm-index.xml"`) do (
  set "line=%%L"
  set "line=!line:*<release>=!"
  for /f "delims=<" %%V in ("!line!") do set "metaVersion=%%V"
)
if "!metaVersion!"=="" (
  echo Could not determine the newest JVM index version 1>&2
  endlocal & exit /b 1
)
set "dlUrl=!base!/!metaVersion!/index-%plat%-!metaVersion!.jar"
set "dlOut=%TDIR%\jvm-index.jar"
call :download || (
  echo Could not download the JVM index 1>&2
  endlocal & exit /b 1
)
if exist "%TDIR%\jvm-index" rmdir /s /q "%TDIR%\jvm-index"
mkdir "%TDIR%\jvm-index"
tar -xf "%TDIR%\jvm-index.jar" -C "%TDIR%\jvm-index" "coursier/jvm/indices/v1/%plat%.json" >nul 2>&1
set "json=%TDIR%\jvm-index\coursier\jvm\indices\v1\%plat%.json"
if not exist "!json!" (
  echo The JVM index has no data for %plat% 1>&2
  endlocal & exit /b 1
)

rem The index is a pretty-printed JSON object per distribution, whose entries
rem read  "<version>": "<zip|tgz>+<url>" . Lines are read whole and split here,
rem so that no line has to be matched with a regular expression.
set "inside=" & set "bestKey=" & set "bestVersion=" & set "bestType=" & set "bestUrl="
for /f "usebackq delims=" %%L in ("!json!") do (
  if not "!inside!"=="done" (
    set "line=%%L"
    set "key=" & set "value="
    for /f tokens^=2^,4^ delims^=^" %%V in ("!line!") do (
      set "key=%%V"
      set "value=%%W"
    )
    if defined inside (
      rem a line without a quoted field ends the temurin object
      if not defined key (
        set "inside=done"
      ) else (
        set "candidateVersion=!key!"
        set "candidateValue=!value!"
        call :index_candidate
      )
    ) else (
      if "!key!"=="temurin" set "inside=1"
    )
  )
)
endlocal & (
  set "idxVersion=%bestVersion%"
  set "idxType=%bestType%"
  set "idxUrl=%bestUrl%"
)
exit /b 0

rem Keeps %candidateVersion% / %candidateValue% ("<type>+<url>") when it is a
rem newer Temurin %bootstrapJavaVersion% than what bestVersion holds. Both are
rem passed in variables, not as arguments: CALL expands % a second time and the
rem JDK URLs contain %%2B.
:index_candidate
for /f "delims=." %%M in ("%candidateVersion%") do set "candidateMajor=%%M"
if not "%candidateMajor%"=="%bootstrapJavaVersion%" exit /b 0
set "candidateType=" & set "candidateUrl="
for /f "tokens=1,* delims=+" %%T in ("%candidateValue%") do (
  set "candidateType=%%T"
  set "candidateUrl=%%U"
)
if not defined candidateUrl exit /b 0
call :version_key "%candidateVersion%"
if not "%versionKey%" GTR "%bestKey%" exit /b 0
set "bestKey=%versionKey%"
set "bestVersion=%candidateVersion%"
set "bestType=%candidateType%"
set "bestUrl=%candidateUrl%"
exit /b 0

rem Sets versionKey to a zero-padded form of the dotted version %1, so that two
rem versions can be compared as strings
:version_key
setlocal
set "p1=0" & set "p2=0" & set "p3=0" & set "p4=0"
for /f "tokens=1-4 delims=." %%A in ("%~1") do (
  if not "%%A"=="" set "p1=%%A"
  if not "%%B"=="" set "p2=%%B"
  if not "%%C"=="" set "p3=%%C"
  if not "%%D"=="" set "p4=%%D"
)
set "k1=00000%p1%" & set "k2=00000%p2%" & set "k3=00000%p3%" & set "k4=00000%p4%"
endlocal & set "versionKey=%k1:~-5%%k2:~-5%%k3:~-5%%k4:~-5%"
exit /b 0

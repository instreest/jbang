#!/usr/bin/env bash
#
# JBangLite launcher for POSIX shells (Linux, macOS, WSL, Git Bash, Cygwin).
#
# It runs jbanglite.jar, so a checkout needs nothing installed, not even a
# JDK. What it does, in order:
#
#   1. Its own options   - --version and --update, answered here without
#                          running the jar or needing a JDK
#   2. Which jar to run  - a jbanglite.jar next to this script when a project
#                          vendors one, otherwise the one that
#                          jbanglite-bootstrap-jar installs from the version
#                          pinned in jbanglite.properties
#   3. Which Java to use - the bootstrap JDK, JAVA_HOME, javac on the PATH, or
#                          the JDK that jbanglite-bootstrap-jdk (next to this
#                          script) downloads when there is none
#   4. Launch            - exec the jar; it builds the script and runs it
#
# That is all it does. Fetching the jar and fetching a JDK belong to the two
# bootstrap scripts, so each can be run, tested and replaced on its own.

# --- 1. This script's own options --------------------------------------------

# The value of key $1 in jbanglite.properties, empty when it is not there
property() {
  [ -f "$propertiesFile" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$propertiesFile" | head -1 | tr -d '\r'
}

# The version the jar $1 reports for itself, empty when it cannot be asked.
# The jar is the authority on its own version, and asking it needs no tool for
# reading a zip; it only needs a JDK that is already here, so nothing is
# downloaded to answer --version.
jar_version() {
  find_existing_java 2>/dev/null || return 0
  "$JAVA_EXEC" -jar "$1" --version 2>/dev/null | head -1 | tr -d '\r'
}

# Prints the version that will actually run, and under it where that was
# decided: the version jbanglite.properties pins, and the jar that will be
# used. Nothing is downloaded.
#
# The cached jar needs no asking to be named: jbanglite-bootstrap-jar puts it
# under the version it pinned and only after its SHA-256 matched, so the
# directory it sits in is its version. A jar a project vendored next to the
# launcher is asked, because it is the one that will run and its version is
# whatever the project put there.
print_version() {
  local pinned vendored cached actual
  pinned=$(property distributionVersion)
  if [ -z "$pinned" ]; then
    echo "No distributionVersion in $propertiesFile" 1>&2
    exit 1
  fi
  vendored=$abs_jbang_dir/jbanglite.jar
  cached=$CACHEDIR/jbanglite/$pinned/jbanglite.jar
  if [ -f "$vendored" ]; then
    actual=$(jar_version "$vendored")
    echo "jbanglite ${actual:-$pinned}"
    echo "  pinned $pinned by $propertiesFile"
    echo "  jar ${actual:-of an unknown version} at $vendored (vendored, so this jar runs and not the pinned version)"
  elif [ -f "$cached" ]; then
    echo "jbanglite $pinned"
    echo "  pinned $pinned by $propertiesFile"
    echo "  jar $pinned at $cached"
  else
    echo "jbanglite $pinned"
    echo "  pinned $pinned by $propertiesFile"
    echo "  jar not installed yet, it is downloaded on the first run"
  fi
}

# Replaces this installation with the one from $1 (a branch, tag or commit of
# the JBangLite repository; the default is whatever install.sh defaults to) by
# running the install.sh that sits next to this script. Needs no Java and no
# jar, so it works even when the pinned jar can no longer be downloaded.
run_update() {
  local installer=$abs_jbang_dir/install.sh
  if [ ! -f "$installer" ]; then
    echo "$installer not found, so this installation cannot update itself." 1>&2
    exit 1
  fi
  if [ -n "$1" ]; then export JBANGLITE_REF=$1; fi
  bash "$installer" "$abs_jbang_dir" || exit $?
  if [ -f "$abs_jbang_dir/jbanglite.jar" ]; then
    echo 1>&2
    echo "Warning: $abs_jbang_dir/jbanglite.jar was not touched, and a jar next to" 1>&2
    echo "the launcher wins over jbanglite.properties, so that old jar still runs." 1>&2
    echo "Remove it, or replace it with the jar of the version just installed." 1>&2
  fi
  exit 0
}

# --- 3. Which Java to use ----------------------------------------------------

# The oldest Java that can run jbanglite.jar
minJavaVersion=11

script_dir() {
  script=${BASH_SOURCE[0]}
  while [ -L "$script" ]; do
    dir=$( cd -P "$( dirname "$script" )" >/dev/null 2>&1 && pwd )
    script=$(readlink "$script")
    [[ $script != /* ]] && script=$dir/$script
  done
  dir=$( cd -P "$( dirname "$script" )" >/dev/null 2>&1 && pwd )
  echo "$dir"
}

# The major version of the JDK or JRE in $1, read from its 'release' file
java_major() {
  local v
  [ -f "$1/release" ] || return 1
  v=$(grep -m1 '^JAVA_VERSION=' "$1/release" | cut -d'"' -f2)
  [ -n "$v" ] || return 1
  case "$v" in
    1.*) v=${v#1.} ;;
  esac
  echo "${v%%[.+_-]*}"
}

# True when $1 holds a JDK (scripts have to be compiled, so a JRE is no use)
# new enough to run jbanglite.jar
usable_java() {
  local major
  [ -x "$1/bin/java" ] && [ -x "$1/bin/javac" ] || return 1
  major=$(java_major "$1") || return 1
  [ "$major" -ge "$minJavaVersion" ] 2>/dev/null
}

# Looks for a JDK that is already on this machine and sets JAVA_EXEC to its
# java, without installing anything; 1 when there is none. Any JDK
# $minJavaVersion or newer will do; the JDK a script asks for with //JAVA is
# chosen by jbanglite.jar itself.
find_existing_java() {
  unset JAVA_EXEC
  # The JDK jbanglite-bootstrap-jdk downloaded on an earlier run
  if usable_java "$CACHEDIR/jdks/bootstrap"; then
    export JAVA_HOME="$CACHEDIR/jdks/bootstrap"
    JAVA_EXEC="$JAVA_HOME/bin/java"
    return
  fi
  if [[ -n "$JAVA_HOME" ]]; then
    if usable_java "$JAVA_HOME"; then
      JAVA_EXEC="$JAVA_HOME/bin/java"
      return
    fi
    echo "JAVA_HOME is set but does not point to a Java $minJavaVersion or newer runtime, ignoring it" 1>&2
  fi
  # javac on the PATH (javac rather than java, because a JRE cannot compile
  # scripts). It is asked where its home is rather than resolved from its own
  # path, because what is on the PATH is often a shim (jenv, SDKMAN, the
  # Windows javapath stub) or a symlink chain that readlink -f does not exist
  # to follow on every platform. -J hands the option to javac's own JVM; it
  # exists since Java 7, and an older javac just prints an error and no
  # java.home, which leaves it ignored.
  local pathJavac pathHome
  pathJavac=$(command -v javac 2>/dev/null)
  if [[ -n "$pathJavac" ]]; then
    pathHome=$("$pathJavac" -J-XshowSettings:properties -version 2>&1 | sed -n 's/^[[:space:]]*java\.home = //p' | head -1)
    if [[ -n "$pathHome" ]] && usable_java "$pathHome"; then
      export JAVA_HOME="$pathHome"
      JAVA_EXEC="$JAVA_HOME/bin/java"
      return
    fi
  fi
  return 1
}

# The java to run jbanglite.jar with, installing one when the machine has none.
# The bootstrap script prints where it put the JDK; everything else it says
# goes to stderr. It is run through bash rather than executed, so a checkout
# that lost the execute bit (core.fileMode=false, a zip download) still works,
# as it does for this script itself.
setup_java_exec() {
  if find_existing_java; then
    return
  fi
  JAVA_HOME=$(bash "$abs_jbang_dir/jbanglite-bootstrap-jdk") || exit 1
  export JAVA_HOME
  JAVA_EXEC="$JAVA_HOME/bin/java"
}

# --- 4. Launch ---------------------------------------------------------------

# The jar does the rest: it builds the script and runs it as a child process
# with our stdin, stdout and stderr, and exits with the script's status. So
# this is a plain exec: nothing is captured, nothing is interpreted.
execute_jbanglite() {
  # shellcheck disable=SC2086 # JBANGLITE_JAVA_OPTIONS is a list of options
  exec "${JAVA_EXEC}" ${JBANGLITE_JAVA_OPTIONS} -jar "${jarPath}" "$@"
}

abs_jbang_dir=$(script_dir)

# Windows shells (Cygwin, Git Bash, MSYS2) hand over to the Windows launcher: it
# only needs what Windows ships with, whereas jbanglite-bootstrap-jdk would need
# unzip, which Git Bash for one does not have. The shell converts POSIX paths
# in the arguments for cmd.exe.
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*)
    if [ -f "$abs_jbang_dir/jbanglite.cmd" ]; then
      cmd /c "$(cygpath -m "$abs_jbang_dir"/jbanglite.cmd)" "$@"
      exit $?
    fi
    ;;
esac

if [[ -z "$JBANGLITE_DIR" ]]; then LITEDIR="$HOME/.jbanglite"; else LITEDIR="$JBANGLITE_DIR"; fi
if [[ -z "$JBANGLITE_CACHE_DIR" ]]; then CACHEDIR="$LITEDIR/cache"; else CACHEDIR="$JBANGLITE_CACHE_DIR"; fi
propertiesFile=$abs_jbang_dir/jbanglite.properties

# The two options this script answers itself. Both are about the installation
# rather than about a script, so neither runs the jar and neither needs a JDK.
case "${1:-}" in
  -V|--version)
    print_version
    exit 0
    ;;
  --update)
    run_update "${2:-}"
    ;;
esac

# --- 2. Which jar to run -----------------------------------------------------

# A project may vendor the jar by dropping it next to this script, and then
# nothing is downloaded. Otherwise the bootstrap script installs the version
# jbanglite.properties pins into the cache, shared by every project on this
# machine, and prints where it put it; everything else it says goes to stderr.
# It is run through bash rather than executed, so a checkout that lost the
# execute bit (core.fileMode=false, a zip download) still works, as it does
# for this script itself.
jarPath=$abs_jbang_dir/jbanglite.jar
if [ ! -f "$jarPath" ]; then
  jarPath=$(bash "$abs_jbang_dir/jbanglite-bootstrap-jar") || exit 1
fi

setup_java_exec

execute_jbanglite "$@"

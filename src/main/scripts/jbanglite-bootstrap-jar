#!/usr/bin/env bash
#
# Installs jbanglite.jar, the JBangLite a project asked for: the version, URL
# and SHA-256 in the jbanglite.properties next to this script, downloaded into
# $JBANG_CACHE_DIR/jbanglite/<version> (~/.jbang/cache/jbanglite/<version>).
# It prints the jar's path on stdout and says nothing else there; progress and
# errors go to stderr. When the jar is already installed it only prints.
#
# The cache is per machine, not per project, so several projects that pin the
# same version share one download. The launcher (jbanglite) runs this when
# there is no jbanglite.jar next to it; it can just as well be run by hand, or
# replaced by anything else that puts the jar there.
#
#   jbanglite-bootstrap-jar            install if needed, print the jar path
#
# Environment:
#   JBANG_DIR, JBANG_CACHE_DIR       where JBangLite keeps things (~/.jbang)
#   JBANGLITE_DIST_URL               where to fetch the jar from, overriding
#                                    distributionUrl (a corporate mirror)
#   JBANG_DOWNLOAD_RETRY, JBANG_DOWNLOAD_RETRY_DELAY
#   JBANGLITE_LOCK_TIMEOUT           seconds to wait for another run's download
#
# Needs curl or wget, and sha256sum or shasum.
#
# Several JBangLite runs can be started at the same time (a build matrix, a
# multi-module build). They share ~/.jbang, so the download takes a directory
# lock (mkdir is atomic) and the jar is written to a file of this run's own
# that is renamed into place.

# --- Settings ----------------------------------------------------------------

# Tells this run's temporary files apart from those of a JBangLite running at
# the same time
runId=$$

# How long to wait (in seconds) for another run that is downloading the same jar
lockTimeout=${JBANGLITE_LOCK_TIMEOUT:-600}

# How often a failed download is retried, and how long to wait in between
# (0 means an exponential backoff of 1, 2, 4, ... seconds)
downloadRetry=${JBANG_DOWNLOAD_RETRY:-5}
downloadRetryDelay=${JBANG_DOWNLOAD_RETRY_DELAY:-0}

if [[ -z "$JBANG_DIR" ]]; then JBDIR="$HOME/.jbang"; else JBDIR="$JBANG_DIR"; fi
if [[ -z "$JBANG_CACHE_DIR" ]]; then TDIR="$JBDIR/cache"; else TDIR="$JBANG_CACHE_DIR"; fi

script_dir() {
  local script dir
  script=${BASH_SOURCE[0]}
  while [ -L "$script" ]; do
    dir=$( cd -P "$( dirname "$script" )" >/dev/null 2>&1 && pwd )
    script=$(readlink "$script")
    [[ $script != /* ]] && script=$dir/$script
  done
  ( cd -P "$( dirname "$script" )" >/dev/null 2>&1 && pwd )
}

# --- The properties ----------------------------------------------------------

# The value of key $1 in $propertiesFile, empty when it is not there. The file
# is ours, so this reads what we write: 'key=value' lines, '#' comments.
property() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$propertiesFile" | head -1 | tr -d '\r'
}

read_properties() {
  if [ ! -f "$propertiesFile" ]; then
    echo "$propertiesFile not found. Re-run $abs_jbang_dir/install.sh to restore it." 1>&2
    return 1
  fi
  distributionVersion=$(property distributionVersion)
  distributionUrl=${JBANGLITE_DIST_URL:-$(property distributionUrl)}
  distributionSha256Sum=$(property distributionSha256Sum)
  if [ -z "$distributionVersion" ] || [ -z "$distributionUrl" ]; then
    echo "$propertiesFile needs a distributionVersion and a distributionUrl" 1>&2
    return 1
  fi
}

# --- Downloading -------------------------------------------------------------

download() {
  local attempt=0
  local maxAttempts=$((downloadRetry + 1))
  while true; do
    attempt=$((attempt + 1))
    if [ -x "$(command -v curl)" ]; then
      curl -sLf -o "$2" "$1"
      retval=$?
    elif [ -x "$(command -v wget)" ]; then
      wget -q -O "$2" "$1"
      retval=$?
    else
      echo "Error: curl or wget not found, please make sure one of them is installed" 1>&2
      exit 1
    fi
    if [ $retval -eq 0 ] || [ $attempt -ge $maxAttempts ]; then
      break
    fi
    if [ "$downloadRetryDelay" -gt 0 ] 2>/dev/null; then
      sleepSeconds=$downloadRetryDelay
    else
      # Exponential backoff: 1, 2, 4, 8, ...
      sleepSeconds=$((1 << (attempt - 1)))
    fi
    echo "Download $attempt/$maxAttempts failed. Retry in $sleepSeconds second(s)..." 1>&2
    if [ $attempt -eq 1 ]; then
      echo "(Set JBANG_DOWNLOAD_RETRY=0 to disable retries)" 1>&2
    fi
    sleep $sleepSeconds
  done
}

sha256_of() {
  if [ -x "$(command -v sha256sum)" ]; then
    sha256sum "$1" | cut -d' ' -f1
  elif [ -x "$(command -v shasum)" ]; then
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# --- Locking -----------------------------------------------------------------

# Several JBangLite runs can share $JBANG_DIR, so the download takes a
# directory lock. mkdir is atomic, so exactly one run gets it; the others wait,
# and stop waiting as soon as $2 shows the work they waited for is done.
#   0 - the lock is ours, do the work and release_lock afterwards
#   1 - gave up (another run is stuck, or its lock directory is stale)
#   2 - no need to do anything, another run already did the work
acquire_lock() {  # $1 = lock directory, $2 = path that exists once the work is done
  local waited=0
  # the lock sits next to what it protects, which may not exist yet
  mkdir -p "$(dirname "$1")"
  while ! mkdir "$1" 2> /dev/null; do
    if [ -e "$2" ]; then return 2; fi
    if [ "$waited" -ge "$lockTimeout" ]; then
      echo "Gave up after $lockTimeout seconds waiting for another JBangLite to finish." 1>&2
      echo "If no other JBangLite is running, remove $1 and try again." 1>&2
      return 1
    fi
    if [ "$waited" -eq 0 ]; then
      echo "Waiting for another JBangLite to finish downloading..." 1>&2
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 0
}

release_lock() {
  rm -rf "$1"
}

# --- Installing --------------------------------------------------------------

# Downloads the jar into $jarDir, one run at a time; the others wait and then
# use what it installed.
install_jar() {
  acquire_lock "$jarDir.lock" "$jarPath"
  case $? in
    2) return 0 ;;
    1) exit 1 ;;
  esac
  install_jar_locked
  retval=$?
  release_lock "$jarDir.lock"
  if [ $retval -ne 0 ]; then exit $retval; fi
}

install_jar_locked() {
  local tmp actual
  # another run may have installed it while we waited for the lock
  if [ -f "$jarPath" ]; then return 0; fi
  mkdir -p "$jarDir"
  # this run's own file, so nothing is shared with a JBangLite running at the
  # same time, and the jar only appears under its real name once it is complete
  tmp="$jarDir/jbanglite-$runId.tmp"

  echo "Downloading JBangLite $distributionVersion..." 1>&2
  download "$distributionUrl" "$tmp"
  if [ $retval -ne 0 ]; then
    rm -f "$tmp"
    echo "Error downloading JBangLite from $distributionUrl" 1>&2
    return 1
  fi

  if [ -n "$distributionSha256Sum" ]; then
    actual=$(sha256_of "$tmp")
    if [ -z "$actual" ]; then
      echo "Neither sha256sum nor shasum is available, cannot verify the download" 1>&2
      rm -f "$tmp"
      return 1
    fi
    if [ "$distributionSha256Sum" != "$actual" ]; then
      rm -f "$tmp"
      echo "SHA-256 mismatch for $distributionUrl: expected $distributionSha256Sum but got $actual" 1>&2
      echo "If you changed the version, update distributionSha256Sum in $propertiesFile." 1>&2
      return 1
    fi
  else
    echo "No distributionSha256Sum in $propertiesFile, skipping verification" 1>&2
  fi

  mv "$tmp" "$jarPath"
  return 0
}

# --- Main --------------------------------------------------------------------

abs_jbang_dir=$(script_dir)
propertiesFile=$abs_jbang_dir/jbanglite.properties

read_properties || exit 1
jarDir="$TDIR/jbanglite/$distributionVersion"
jarPath="$jarDir/jbanglite.jar"

if [ ! -f "$jarPath" ]; then
  install_jar
fi

echo "$jarPath"
